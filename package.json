{
  "name": "focus-board",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Focus Board",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "scripts/rebuild-native.sh --electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "scripts/rebuild-native.sh --node && vitest run",
    "test:watch": "vitest",
    "test:cleanup": "scripts/kill-vitest.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "selfsigned": "^5.5.0",
    "uuid": "^14.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/selfsigned": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
